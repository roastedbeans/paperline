                <mxCell id="cap_eavesdrop" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Eavesdrop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color:#212121;&quot;&gt;Read every pre-AS-security RRC and NAS frame in the clear: SIB, Identity Request / Response, Authentication Request, Capability Enquiry.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1;fontSize=13;fontColor=#c0504d;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
