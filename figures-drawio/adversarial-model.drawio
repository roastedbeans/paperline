                    <mxGeometry x="315" y="410" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="cap_drop" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Drop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color:#212121;&quot;&gt;Suppress expected frames so the UE retries or stalls: Authentication Request, Security Mode Command, Attach Accept, keeping the UE on the rogue cell.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1;fontSize=13;fontColor=#c0504d;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="565" y="410" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="cap_inject" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Inject&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color:#212121;&quot;&gt;Synthesize new frames the UE will accept: forged Identity Request to harvest IMSI, forged TAU / Attach Reject to deny service, forged RRC Reconfiguration.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1;fontSize=13;fontColor=#c0504d;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
