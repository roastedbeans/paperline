                <mxCell id="e_sib_setup" value="0.50" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=1.5;fontSize=13;fontColor=#212121;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="s_sib" target="s_setup">
